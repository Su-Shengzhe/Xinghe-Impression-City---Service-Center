# Copy this file to deploy/docker.env and replace every CHANGE_ME value.
# Do not send a real docker.env file to other people or commit it.

XINGHE_VERSION=1.0.0
WEB_PORT=8080
BACKEND_PORT=8081
RABBITMQ_MANAGEMENT_PORT=15672

MYSQL_DATABASE=xinghe_trade
MYSQL_USERNAME=xinghe
MYSQL_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD

RABBITMQ_USERNAME=xinghe
RABBITMQ_PASSWORD=CHANGE_ME_RABBITMQ_PASSWORD
SPRING_SESSION_REDIS_NAMESPACE=xinghe:session
XINGHE_MESSAGING_ENABLED=true

# Elasticsearch is intentionally disabled in the default Docker package because
# this project requires an Elasticsearch image with the IK analysis plugin.

# Keep these false for normal startup. See deploy/DEPLOYMENT.md for the one-time
# employee bootstrap procedure.
XINGHE_AUTH_EMPLOYEE_SEED_ENABLED=false
XINGHE_AUTH_EMPLOYEE_SEED_USERNAME=store-admin
XINGHE_AUTH_EMPLOYEE_SEED_PASSWORD=CHANGE_ME_EMPLOYEE_PASSWORD
XINGHE_AUTH_EMPLOYEE_SEED_STORE_ID=1

# Optional OpenAI-compatible customer-service Agent.
XINGHE_AGENT_ENABLED=false
XINGHE_AGENT_API_KEY=
XINGHE_AGENT_BASE_URL=https://api.openai.com/v1
XINGHE_AGENT_MODEL=gpt-4o-mini
XINGHE_AGENT_TIMEOUT=8s
