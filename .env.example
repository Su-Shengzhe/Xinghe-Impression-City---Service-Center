# Copy to .env for local development. Never commit .env or real credentials.

# Spring datasource
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=xinghe_trade
MYSQL_USERNAME=root
MYSQL_PASSWORD=change-me

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
# Set to the same isolated name as MYSQL_DATABASE for messaging acceptance; do not use /.
SPRING_RABBITMQ_VIRTUAL_HOST=xinghe_stage_e

# Elasticsearch
ELASTICSEARCH_URI=http://localhost:9200

# Application
SERVER_PORT=8081
XINGHE_SEED_ENABLED=false
XINGHE_MESSAGING_ENABLED=false
XINGHE_ORDER_EXPIRY_SCAN_MS=30000
XINGHE_ELASTICSEARCH_ENABLED=false
# Maintenance only: full ES rebuild deletes the live index; keep this false during normal service.
XINGHE_INDEX_REBUILD_API_ENABLED=false
# Optional one-shot trusted employee seed for a known store; never enable in production.
XINGHE_AUTH_EMPLOYEE_SEED_ENABLED=false
XINGHE_AUTH_EMPLOYEE_SEED_USERNAME=
XINGHE_AUTH_EMPLOYEE_SEED_PASSWORD=
XINGHE_AUTH_EMPLOYEE_SEED_STORE_ID=0

# Optional OpenAI-compatible customer Agent
XINGHE_AGENT_ENABLED=false
XINGHE_AGENT_API_KEY=
XINGHE_AGENT_BASE_URL=https://api.openai.com/v1
XINGHE_AGENT_MODEL=gpt-4o-mini
XINGHE_AGENT_TIMEOUT=8s
